# Copy to .env and export (or pass to docker --env-file). Everything is optional:
# with no variables the app runs fully offline on SQLite + a local vector file.

APP_TOKEN=change-me            # require "Authorization: Bearer <token>" (set this before exposing publicly)
DATA_DIR=./data

# --- Delta tables on Databricks (relational data: plans, cards, reviews, log) ---
# STORE_BACKEND=databricks
# DATABRICKS_HOST=https://dbc-xxxx.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...          # personal access token or service-principal token
# DATABRICKS_WAREHOUSE_ID=abc123...
# DATABRICKS_CATALOG=main
# DATABRICKS_SCHEMA=porygon_learn

# --- Vector store in S3 (Amazon S3 Vectors) ---
# VECTOR_BACKEND=s3vectors
# AWS_REGION=us-east-1
# S3_VECTOR_BUCKET=my-porygon-vectors
# S3_VECTOR_INDEX=learning-chunks

# --- Embeddings (dimension must match the vector index) ---
# EMBED_BACKEND=databricks          # or: bedrock
# EMBED_ENDPOINT=databricks-gte-large-en
# EMBED_DIM=1024

# --- LLM for research / lessons / flashcard drafting ---
# LLM_BACKEND=databricks            # or: bedrock
# LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
# BEDROCK_LLM_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
